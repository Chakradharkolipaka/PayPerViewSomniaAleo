# Active EVM network
NEXT_PUBLIC_NETWORK=somnia

# Public Somnia RPC
NEXT_PUBLIC_SOMNIA_RPC_URL=https://dream-rpc.somnia.network/

# Deployed Somnia contracts
NEXT_PUBLIC_PAYPERVIEW_ADDRESS=
NEXT_PUBLIC_ACCESS_NFT_ADDRESS=
NEXT_PUBLIC_PROOF_VERIFIER_ADDRESS=

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deploy key (DO NOT COMMIT)
PRIVATE_KEY=

# Backend chain endpoints
SOMNIA_RPC_URL=https://dream-rpc.somnia.network/
SOMNIA_WS_RPC_URL=wss://dream-rpc.somnia.network/ws

# Aleo execution (backend)
ALEO_MOCK_MODE=true
ALEO_PROGRAM_ID=
ALEO_PRIVATE_KEY=
ALEO_RPC_URL=https://api.explorer.provable.com/v1
ALEO_NETWORK=testnet

# Verifier contract used by ProofVerifier.sol
VERULINK_ALEO_VERIFIER_ADDRESS=

# Encrypted static asset mappings
ENCRYPTED_ASSET_VIDEO_1=

# Optional client debug mode
NEXT_PUBLIC_DEBUG_MODE=false
