# .env.example
# Copy this to .env.local and fill in your values for each environment (local, testnet, mainnet).
# DO NOT commit .env.local to git.

# ============================================================================
# NETWORK & RPC CONFIGURATION
# ============================================================================

# Somnia EVM Network
# Local: http://localhost:8545
# Testnet: https://somnia-testnet-rpc.allthatnode.com:8545
# Mainnet: https://somnia-mainnet-rpc.allthatnode.com:8545
NEXT_PUBLIC_RPC_URL=https://somnia-testnet-rpc.allthatnode.com:8545
NEXT_PUBLIC_CHAIN_ID=50312
NEXT_PUBLIC_SOMNIA_RPC_URL=https://dream-rpc.somnia.network/

# ============================================================================
# SMART CONTRACTS (Somnia Testnet/Mainnet)
# ============================================================================

# Deployed in this order: AccessNFT → PayPerView (pass AccessNFT address) → call setMinter
NEXT_PUBLIC_ACCESS_NFT_ADDRESS=0x...
NEXT_PUBLIC_PAYPERVIEW_ADDRESS=0x...

# ============================================================================
# ALEO PROGRAM
# ============================================================================

# Program ID for video_access.aleo
NEXT_PUBLIC_ALEO_PROGRAM_ID=video_access_<network>

# Aleo Studio endpoint (defaults to app.aleo.org)
NEXT_PUBLIC_ALEO_STUDIO_ENDPOINT=https://api.studio.aleo.org

# ==========================================================================
# SERVER ROUTE HANDLERS (NEXT.JS)
# ==========================================================================

# Route handlers read these server-only values directly.
SOMNIA_RPC_URL=https://dream-rpc.somnia.network/
BACKEND_PRIVATE_KEY=0x...
ACCESS_NFT_ADDRESS=0x...

# ============================================================================
# DECRYPTION KEYS (Server Only)
# ============================================================================

# Hex-encoded AES-256 keys for each video (generated via scripts/encrypt-video.mjs).
# Format: DECRYPTION_KEY_VIDEO_<videoId>=<hex-key>
# Example:
#   DECRYPTION_KEY_VIDEO_1=a1b2c3d4e5f6....(64 hex chars = 256 bits)
#   DECRYPTION_KEY_VIDEO_2=f6e5d4c3b2a1....(64 hex chars = 256 bits)

DECRYPTION_KEY_VIDEO_1=
DECRYPTION_KEY_VIDEO_2=
# Add more as needed...

# ============================================================================
# DEBUG MODE
# ============================================================================

# Enable debug panel (displays ViewStep, addresses, tx hashes, events).
# Set to "true" to render DebugPanel component; leave empty or "false" to hide.
NEXT_PUBLIC_DEBUG=false

# ============================================================================
# OPTIONAL: VIDEO CATALOG (Hardcoded for now; move to route handlers later)
# ============================================================================

# Static video metadata (title, duration, cover URL) will be hardcoded in src/app/layout.tsx.
# Example catalog:
#   {
#     id: "1",
#     title: "Building with Aleo",
#     durationSeconds: 600,
#     coverUrl: "https://...",
#     videoUrl: "/encrypted/video_1.enc", // Static encrypted asset
#   }

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================

# 1. Contract Deployment Sequence:
#    a. Deploy AccessNFT.sol (note address)
#    b. Deploy PayPerView.sol, pass AccessNFT address to constructor
#    c. Call AccessNFT.setMinter(PayPerView.address) to allow pay() to mint
#
# 2. Aleo Program Deployment:
#    a. Deploy video_access.aleo to Aleo mainnet / testnet
#    b. Set NEXT_PUBLIC_ALEO_PROGRAM_ID to deployed program ID
#
# 3. Video Encryption & Server Setup:
#    a. For each video: node scripts/encrypt-video.mjs video.mp4 <videoId>
#    b. Move encrypted files to public/encrypted/ (auto-done by script)
#    c. Set DECRYPTION_KEY_VIDEO_<id> env vars in app/server env
#
# 4. Server Route Deployment:
#    a. Set SOMNIA_RPC_URL, BACKEND_PRIVATE_KEY, and ACCESS_NFT_ADDRESS
#    b. Ensure the route handlers can read DECRYPTION_KEY_VIDEO_* env vars
#    c. Route handlers verify NFT ownership via RPC (SOMNIA_RPC_URL)
#
# 5. Frontend Deployment:
#    a. Build: npm run build
#    b. Set all NEXT_PUBLIC_* vars in deployment platform (Vercel, etc.)
#    c. Verify no YouTube URLs in build artifacts (lint check: grep -r "youtube" public/ .next/)
#
# 6. Pre-launch Checklist:
#    ✓ All NEXT_PUBLIC_* vars set correctly
#    ✓ DECRYPTION_KEY_VIDEO_* vars set in server environment
#    ✓ Aleo program deployed and verified
#    ✓ Smart contracts verified on block explorer
#    ✓ Route endpoint accessible from frontend
#    ✓ Test full PPV flow (pay → mint → consume → decrypt)
#    ✓ No YouTube URLs anywhere (grep check passes)
